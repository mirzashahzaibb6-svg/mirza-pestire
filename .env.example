# ============================================================
#  ✦ MIRZA BAKERY — Environment Template
#  Copy this file to ".env" and fill in your own values:
#      cp .env.example .env
# ============================================================

# -------------------- SERVER --------------------
PORT=3000
NODE_ENV=development
HOST=0.0.0.0
APP_NAME=Mirza Bakery
APP_URL=http://localhost:3000
# Comma-separated list of allowed frontend origins ("*" = allow all)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# -------------------- JWT / AUTH --------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# -------------------- STORE / ORDERS --------------------
CURRENCY=PKR
DELIVERY_FEE=250
FREE_DELIVERY_ABOVE=10000
TAX_PERCENT=0
ORDER_PREFIX=MRZ

# -------------------- CONTACT / SUPPORT --------------------
SUPPORT_EMAIL=orders@mirzabakery.com
SUPPORT_PHONE=+92 300 0000000
SUPPORT_WHATSAPP=+92 300 0000000

# -------------------- ADMIN ACCOUNT --------------------
# Seeded automatically on server start (change the password!)
ADMIN_NAME=Mirza Admin
ADMIN_EMAIL=admin@mirzabakery.com
ADMIN_PASSWORD=replace_with_a_strong_password

# -------------------- DATABASE (optional) --------------------
# DB_TYPE=memory
# MONGO_URI=mongodb://127.0.0.1:27017/mirza_bakery
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=mirza_bakery

# -------------------- EMAIL / SMTP (optional) --------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Mirza Bakery <orders@mirzabakery.com>

# -------------------- SOCIAL LOGIN (optional) --------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# -------------------- PAYMENTS (optional) --------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=
